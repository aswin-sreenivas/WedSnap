# ==============================================================================
# WedSnap – Environment Variable Reference (Vercel Production / Preview / Local)
# ==============================================================================
# NEVER commit real secrets (.env, .env.local, .env.production) to Git.
# Variables prefixed with VITE_ are exposed to the browser bundle (public only).
# All variables without VITE_ are strictly server-side only.
# ==============================================================================

# --- Canonical Public Origin (Vercel Production & Preview) ---
# Used server-side for canonical <link>, OpenGraph URLs, sitemap.xml, and robots.txt.
# On Vercel Preview, set to your preview alias or leave APP_URL for Production only
# (server falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL / Host header).
APP_URL="https://wedsnap.example.com"

# --- Optional: Gemini AI API Key (Server-Side Only) ---
# Environment: Local Development, Vercel Preview, Vercel Production
GEMINI_API_KEY=""

# --- Public Firebase Web Configuration (Safe for Browser) ---
# Optional overrides for firebase-applet-config.json across environments.
# Environment: Local Development, Vercel Preview, Vercel Production
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# --- Public Google Analytics 4 (Consent-Gated) ---
# Stays completely disabled until configured AND the visitor accepts analytics consent.
# Environment: Vercel Production (optional in Preview)
VITE_GA_MEASUREMENT_ID=""

# --- Server-Side Firebase Admin Credentials (NEVER prefix with VITE_) ---
# Required on Vercel if using full Admin SDK Firestore/Storage operations.
# Paste the single-line JSON contents of your Google Cloud Service Account key.
# Leave empty on AI Studio Starter Tier (server falls back to ID-token verification + Firestore REST).
# Environment: Vercel Production, Vercel Preview
FIREBASE_SERVICE_ACCOUNT_JSON=""

# --- Server-Side Google Drive OAuth (Optional Studio Offline Refresh Flow) ---
# Required only when enabling server-side Google OAuth code exchange with refresh tokens.
# Standard Firebase popup Drive access works without these.
# Environment: Vercel Production, Vercel Preview, Local Development
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# --- Media Signing & Background Worker Secrets (Server-Side Only) ---
# Generate strong random 32+ byte hex strings (`openssl rand -hex 32`).
# MEDIA_SIGNING_SECRET signs short-lived organizer draft photo URLs across serverless instances.
# WORKER_SHARED_SECRET authenticates scheduled/external Cloud Tasks / Cloud Run indexing triggers.
# Environment: Vercel Production, Vercel Preview
MEDIA_SIGNING_SECRET=""
WORKER_SHARED_SECRET=""

# --- Optional: Scheduled Firestore Backup Bucket (Google Cloud Storage) ---
# Used by scripts/backup-firestore.sh for automated Cloud Firestore exports.
# Environment: External GCP / CI Runner
BACKUP_BUCKET="gs://your-wedsnap-firestore-backups"
